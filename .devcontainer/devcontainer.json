{
  "name": "Budget App",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",

  "workspaceFolder": "/workspaces/budget-app",

  // Docker-in-Docker (not the host socket): the smoke and auth tests reach
  // published ports on 127.0.0.1, which must be this container's loopback.
  // moby: false installs Docker CE instead of Moby. The base image is Debian
  // trixie, which has no moby-cli packages, so the default fails to install.
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "moby": false
    }
  },

  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Vite Dev Server",
      "onAutoForward": "notify"
    }
  },

  // Keep the container's node_modules in a named volume so it doesn't share
  // (and clobber) the host's node_modules. Native deps like rollup, esbuild,
  // lightningcss and tailwind oxide ship per-platform binaries, so a
  // linux-arm64 install breaks the Mac build and vice versa.
  "mounts": [
    "source=budget-app-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    // Persist Claude Code login + session history across container rebuilds.
    "source=budget-app-claude-config,target=/home/node/.claude,type=volume",
    // Cache the headless Chromium used by the Playwright MCP server (.mcp.json)
    // so rebuilds only reinstall its apt dependencies, not the browser.
    "source=budget-app-playwright-cache,target=/home/node/.cache/ms-playwright,type=volume"
  ],

  // Keep ~/.claude.json inside the persisted dir too (it normally lives in $HOME).
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude"
  },

  // The last step installs Chromium + system libs from the same Playwright
  // build that the pinned @playwright/mcp version in .mcp.json uses; bump both together.
  "postCreateCommand": "sudo chown node:node node_modules /home/node/.claude && sudo mkdir -p /home/node/.cache/ms-playwright && sudo chown -R node:node /home/node/.cache && npm ci && npm --prefix server/auth ci && npx -y -p @playwright/mcp@0.0.86 playwright-core install --with-deps chromium",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "dsznajder.es7-react-js-snippets",
        "Anthropic.claude-code"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "eslint.useFlatConfig": true,
        "files.exclude": {
          "**/node_modules": true,
          "**/.git": false
        }
      }
    }
  }
}