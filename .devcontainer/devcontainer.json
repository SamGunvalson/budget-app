{
  "name": "Budget App",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",

  "workspaceFolder": "/workspaces/budget-app",

  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Vite Dev Server",
      "onAutoForward": "notify"
    }
  },

  // Keep the container's node_modules in a named volume so it doesn't share
  // (and clobber) the host's node_modules. Native deps like rollup, esbuild,
  // lightningcss and tailwind oxide ship per-platform binaries, so a
  // linux-arm64 install breaks the Mac build and vice versa.
  "mounts": [
    "source=budget-app-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],

  "postCreateCommand": "sudo chown node:node node_modules && npm ci",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "dsznajder.es7-react-js-snippets",
        "Anthropic.claude-code"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "eslint.useFlatConfig": true,
        "files.exclude": {
          "**/node_modules": true,
          "**/.git": false
        }
      }
    }
  }
}