# Copy to .env.selfhost and fill in. Never commit the real file.
# DB passwords are embedded in postgres:// URIs, so use hex (no URL-special chars):
#   openssl rand -hex 32
POSTGRES_PASSWORD=
AUTHENTICATOR_PASSWORD=
AUTH_ADMIN_PASSWORD=

# JWT signing secret shared by auth service and PostgREST (>= 32 chars):
#   openssl rand -base64 48
JWT_SECRET=

# Allow new account registration (set false after creating your account)
ALLOW_SIGNUP=true

# Host port for the web app
# APP_PORT=8085
# Interface to publish on. nginx serves plain HTTP, so only expose it on a trusted
# encrypted network (e.g. Tailscale) or bind to 127.0.0.1 behind a TLS reverse proxy.
# APP_BIND=0.0.0.0
