# Loaded by `npm run build:android` (vite --mode android). Overrides .env so the
# Android app never bakes in Supabase credentials; on first launch it shows
# "Connect to your server" and uses the self-hosted backend you enter.
# Contains no secrets — safe to commit.
VITE_BACKEND_MODE=local
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_ORIGIN=
