# Frontend dev settings. Copy to .env for `npm run dev`:
#   cp .env.example .env
# Start the self-hosted stack first (see docs/SETUP_GUIDE.md), then point Vite at it.

# Proxy /rest/v1 and /auth/v1 through the Vite dev server to the stack (recommended):
DEV_API_PROXY_TARGET=http://localhost:8085

# Or call the stack directly from the browser instead of proxying:
# VITE_API_ORIGIN=http://localhost:8085
